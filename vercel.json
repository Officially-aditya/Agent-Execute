{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/agent-stream.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/agent/run",
      "destination": "/api/agent-stream?__path=/api/agent/run"
    },
    {
      "source": "/api/sessions/:sessionId/continue",
      "destination": "/api/agent-stream?__path=/api/sessions/:sessionId/continue"
    },
    {
      "source": "/api/agent-stream",
      "destination": "/api/agent-stream"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/server?__path=/api/:path*"
    }
  ]
}
