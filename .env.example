# LLM (server-side only)
LLM_API_KEY=
LLM_MODEL=gpt-5.5
LLM_BASE_URL=

# Razorpay Test Mode only (server-side only)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# Persistence
# Local default: SQLite file.
DATABASE_URL=.data/agent-execute.sqlite
# Vercel/Neon: set DATABASE_URL (or NEON_DATABASE_URL) to postgresql://... from Neon.
NEON_DATABASE_URL=

# Merchant quote signing
# Local only: npm run setup can persist keys in this directory.
MERCHANT_KEY_DIR=.data
# Vercel: both signing keys are required as environment variables.
MERCHANT_SIGNING_PRIVATE_KEY=
MERCHANT_SIGNING_PUBLIC_KEY=

# Services
AGENT_PORT=3001
MERCHANT_ADMIN_PORT=3002
WEB_ORIGIN=http://localhost:3001
QUOTE_TTL_SECONDS=60
