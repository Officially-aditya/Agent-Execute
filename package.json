{
  "name": "agent-execute",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev:agent",
    "dev:agent": "tsx apps/agent-service/src/index.ts",
    "dev:mcp": "tsx apps/merchant-mcp/src/index.ts",
    "dev:admin": "tsx apps/merchant-admin/src/index.ts",
    "start": "tsx apps/agent-service/src/index.ts",
    "build": "npm run vercel-build",
    "vercel-build": "npm run typecheck && npm run check:vercel-api && rm -rf public && cp -R apps/web/public public",
    "check:vercel-api": "node scripts/verify-vercel-api.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:mcp": "vitest run tests/mcp",
    "test:live:llm": "RUN_LIVE_LLM=1 vitest run tests/live/agent.live.test.ts",
    "test:live:razorpay": "RUN_LIVE_RAZORPAY=1 vitest run tests/live/razorpay-order.live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run check:vercel-api && npm test",
    "setup": "tsx packages/quote-integrity/src/setup-keys.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "openai": "7.9.0",
    "razorpay": "2.9.8",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "engines": { "node": "22.x" }
}
