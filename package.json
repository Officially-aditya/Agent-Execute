{
  "name": "agent-execute",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n agent,admin \"npm run dev:agent\" \"npm run dev:admin\"",
    "dev:agent": "tsx apps/agent-service/src/index.ts",
    "dev:mcp": "tsx apps/merchant-mcp/src/index.ts",
    "dev:admin": "tsx apps/merchant-admin/src/index.ts",
    "start": "tsx apps/agent-service/src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:mcp": "vitest run tests/mcp",
    "test:live:llm": "RUN_LIVE_LLM=1 vitest run tests/live/agent.live.test.ts",
    "test:live:razorpay": "RUN_LIVE_RAZORPAY=1 vitest run tests/live/razorpay-order.live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "setup": "tsx packages/quote-integrity/src/setup-keys.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "openai": "7.9.0",
    "razorpay": "2.9.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=20" }
}
